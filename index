    const n = norm(name);
    const tol = n.length <= 4 ? 0 : n.length <= 8 ? 1 : 2;
    return g === n || lev(g, n) <= tol;
  });
}
function shuffle(a) { a = a.slice(); for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; } return a; }
function letterPattern(t) { return t.replace(/[A-Za-z0-9]/g, (c, i) => i === 0 ? c.toUpperCase() : "_"); }
function esc(s) { return s.replace(/[&<>"]/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c])); }

function hintsFor(item) {
  return [
    { k: "Format", v: `${item.type === "tv" ? "TV show" : "Movie"} from ${item.year}` },
    { k: "Genre", v: item.genre },
    { k: "Clue", v: item.clue },
    { k: "Letters", v: `<span class="letters">${esc(letterPattern(item.t))}</span>`, html: true },
  ];
}

function newGame() {
  const pool = TITLES.filter(x => S.cat === "all" || x.type === S.cat);
  S.queue = shuffle(pool).slice(0, Math.min(ROUND_SIZE, pool.length));
  S.idx = 0; S.score = 0; S.streak = 0; S.best = 0; S.log = [];
  startItem();
}
function startItem() {
  const item = S.queue[S.idx];
  S.cur = { item, hintsUsed: 0, guesses: 0, done: false, msg: "", msgType: "" };
  if (LEVELS[S.diff].mc) {
    const others = shuffle(TITLES.filter(x => x !== item && (S.cat === "all" || x.type === item.type))).slice(0, 3);
    S.cur.options = shuffle([item, ...others]);
  }
  render();
  const inp = $("guess-input"); if (inp) inp.focus({ preventScroll: true });
}
function worth() {
  const L = LEVELS[S.diff];
  return Math.max(0, Math.round(L.pts * (1 - 0.2 * S.cur.hintsUsed)));
}
function finish(correct) {
  const c = S.cur; c.done = true;
  const pts = correct ? worth() : 0;
  if (correct) { S.score += pts; S.streak++; S.best = Math.max(S.best, S.streak); }
  else S.streak = 0;
  S.log.push({ t: c.item.t, pts, correct });
  c.msg = correct ? `Correct! +${pts} points.` : "Out of guesses.";
  c.msgType = correct ? "good" : "bad";
  render();
  const nx = $("next"); if (nx) nx.focus({ preventScroll: true });
}
function next() {
  S.idx++;
  if (S.idx >= S.queue.length) renderEnd(); else startItem();
}

function updateBoard() {
  $("score").textContent = S.score;
  $("streak").textContent = S.streak;
  $("round").textContent = `${Math.min(S.idx + 1, S.queue.length)}/${S.queue.length}`;
}

function render() {
  updateBoard();
  const c = S.cur, item = c.item, L = LEVELS[S.diff];
  const hints = hintsFor(item).slice(0, L.hints);
  const shown = hints.slice(0, c.hintsUsed);
  const desc = item[S.diff];
  let answerArea = "";
  if (!c.done) {
    if (L.mc) {
      answerArea = `<div class="choices">${c.options.map((o, i) =>
        `<button type="button" class="choice" data-i="${i}">${esc(o.t)}</button>`).join("")}</div>`;
    } else {
      answerArea = `<div class="guess">
        <label for="guess-input" class="label" style="flex-basis:100%;margin:0">Your guess</label>
        <input id="guess-input" type="text" autocomplete="off" placeholder="Type a title…" aria-describedby="fb">
        <button class="btn hot" type="button" id="guess-btn">Guess</button>
      </div>`;
    }
  } else if (L.mc) {
    answerArea = `<div class="choices">${c.options.map(o =>
      `<button type="button" class="choice ${o === item ? "right" : (o === c.picked ? "wrong" : "")}" disabled>${esc(o.t)}</button>`).join("")}</div>`;
  }

  stage.innerHTML = `
    <div class="spine">
      <b>Tape ${S.idx + 1} of ${S.queue.length}</b>
      <span>${L.label} · worth ${c.done ? "—" : worth() + " pts"}</span>
    </div>
    <div class="sticker" aria-hidden="true">${L.label}<br>${L.pts}</div>
    <div class="case-body">
      <div>
        <p class="label">The plot, roughly</p>
        <p class="desc">${esc(desc)}</p>
      </div>
      <div class="hints">
        ${shown.length ? `<ul class="hint-list">${shown.map(h => `<li><i>${h.k}</i><span>${h.html ? h.v : esc(h.v)}</span></li>`).join("")}</ul>` : ""}
        <div class="row">
          ${!c.done ? `<button type="button" class="btn" id="hint" ${c.hintsUsed >= hints.length ? "disabled" : ""}>
            ${c.hintsUsed >= hints.length ? "No hints left" : `Get a hint (${hints.length - c.hintsUsed} left, −${Math.round(L.pts * 0.2)} pts)`}</button>` : ""}
          ${!c.done && !L.mc ? `<span class="meta">Guesses left: ${MAX_GUESSES - c.guesses}</span>` : ""}
        </div>
      </div>
      ${answerArea}
      <p class="feedback ${c.msgType}" id="fb">${esc(c.msg)}</p>
      ${c.done ? `
        <div class="reveal">
          <p class="label">It was</p>
          <h2>${esc(item.t)}</h2>
          <p>${item.type === "tv" ? "TV show" : "Movie"}, ${item.year}. ${esc(item.easy)}</p>
          <div class="row"><button type="button" class="btn primary" id="next">${S.idx + 1 >= S.queue.length ? "See results" : "Next tape →"}</button></div>
        </div>` : `
        <div class="row"><button type="button" class="btn ghost" id="giveup">Give up and reveal</button></div>`}
    </div>`;

  const hb = $("hint");
  if (hb) hb.onclick = () => { if (S.cur.hintsUsed < hints.length) { S.cur.hintsUsed++; render(); } };
  const gu = $("giveup");
  if (gu) gu.onclick = () => { S.cur.msg = ""; finish(false); S.cur.msg = "Revealed."; S.cur.msgType = "bad"; render(); };
  const nx = $("next");
  if (nx) nx.onclick = next;
  const gb = $("guess-btn"), gi = $("guess-input");
  const submitGuess = () => {
    const v = gi.value;
    if (!v.trim()) return;
    S.cur.guesses++;
    if (isMatch(v, item)) return finish(true);
    if (S.cur.guesses >= MAX_GUESSES) return finish(false);
    S.cur.msg = `“${v.trim()}” isn't it. ${MAX_GUESSES - S.cur.guesses} left.`;
    S.cur.msgType = "bad";
    render();
    $("guess-input").focus({ preventScroll: true });
  };
  if (gb) {
    gb.onclick = submitGuess;
    gi.onkeydown = e => { if (e.key === "Enter") { e.preventDefault(); submitGuess(); } };
  }
  stage.querySelectorAll(".choice[data-i]").forEach(b => b.onclick = () => {
    const pick = S.cur.options[+b.dataset.i];
    S.cur.picked = pick;
    finish(pick === item);
  });
}

function renderEnd() {
  S.idx = S.queue.length - 1; updateBoard();
  const right = S.log.filter(x => x.correct).length;
  const max = S.queue.length * LEVELS[S.diff].pts;
  const verdict = right === S.queue.length ? "Flawless. You've seen everything."
    : right >= S.queue.length * 0.7 ? "Video store employee of the month."
    : right >= S.queue.length * 0.4 ? "Solid. Maybe watch a few more."
    : "Rough night at the rental counter.";
  stage.innerHTML = `
    <div class="spine"><b>Game over</b><span>${LEVELS[S.diff].label}</span></div>
    <div class="case-body end">
      <h2>${S.score} / ${max}</h2>
      <p style="margin:0">${right} of ${S.queue.length} correct · best streak ${S.best}. ${verdict}</p>
      <ul class="recap">${S.log.map(x => `<li><span>${x.correct ? "✓" : "✗"} ${esc(x.t)}</span><span>${x.pts} pts</span></li>`).join("")}</ul>
      <div class="row"><button type="button" class="btn primary" id="again">Play again</button></div>
    </div>`;
  $("again").onclick = newGame;
  $("again").focus({ preventScroll: true });
}

function bindSeg(id, key) {
  $(id).querySelectorAll("button").forEach(b => b.onclick = () => {
    $(id).querySelectorAll("button").forEach(x => x.setAttribute("aria-pressed", x === b ? "true" : "false"));
    S[key] = b.dataset.v;
    newGame();
  });
}
S.diff = "medium"; S.cat = "all";
bindSeg("diff", "diff"); bindSeg("cat", "cat");
$("newgame").onclick = newGame;
newGame();
</script>

</html>
