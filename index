<style>
/* Layout: one centered game column styled like a video-rental tape case: header strip, settings row, the "case" with the description, hint stickers, guess area. */
:root {
  --bg: #e6eaf0;
  --panel: #ffffff;
  --ink: #171a2c;
  --muted: #5b6178;
  --line: #c9cfdb;
  --accent: #d2302c;
  --accent-ink: #ffffff;
  --sticker: #f4c20d;
  --sticker-ink: #171a2c;
  --good: #1f8a4c;
  --bad: #c0362f;
  --soft: #f1f3f7;
  --font-display: "Anton", Impact, "Arial Narrow", sans-serif;
  --font-body: "Karla", "Helvetica Neue", Arial, sans-serif;
  --font-mono: "Courier Prime", "Courier New", Courier, monospace;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #11131d; --panel: #1b1e2c; --ink: #eef0f7; --muted: #a2a8bf; --line: #333850;
    --accent: #ff5a4e; --accent-ink: #14060a; --sticker: #f4c20d; --sticker-ink: #171a2c;
    --good: #4cc77f; --bad: #ff6b60; --soft: #242839; color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --bg: #11131d; --panel: #1b1e2c; --ink: #eef0f7; --muted: #a2a8bf; --line: #333850;
  --accent: #ff5a4e; --accent-ink: #14060a; --sticker: #f4c20d; --sticker-ink: #171a2c;
  --good: #4cc77f; --bad: #ff6b60; --soft: #242839; color-scheme: dark;
}
* { box-sizing: border-box; }
body {
  background: var(--bg); color: var(--ink);
  font-family: var(--font-body); font-size: 16px; line-height: 1.5;
  padding-inline: 16px; padding-block: 24px 48px;
}
.wrap { max-width: 720px; margin: 0 auto; display: grid; gap: 20px; }

header { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 12px; }
h1 {
  font-family: var(--font-display); font-weight: 400; margin: 0;
  font-size: clamp(40px, 10vw, 64px); line-height: .95; letter-spacing: .02em; text-transform: uppercase;
  color: var(--ink); text-wrap: balance;
}
h1 span { color: var(--accent); }
.tagline { margin: 6px 0 0; color: var(--muted); max-width: 46ch; }
.scoreboard { display: flex; gap: 18px; font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
.scoreboard div { display: grid; }
.scoreboard small { font-size: 11px; text-transform: uppercase; letter-spacing: .1em; color: var(--muted); }
.scoreboard b { font-size: 22px; font-weight: 500; }

.settings { display: flex; flex-wrap: wrap; gap: 16px 28px; align-items: center; }
.group { display: grid; gap: 6px; }
.group > span { font-size: 11px; text-transform: uppercase; letter-spacing: .12em; color: var(--muted); font-weight: 600; }
.seg { display: inline-flex; border: 2px solid var(--ink); border-radius: 8px; overflow: hidden; }
.seg button {
  font: 600 14px var(--font-body); padding: 7px 14px; border: 0; background: var(--panel); color: var(--ink);
  cursor: pointer; border-left: 2px solid var(--ink);
}
.seg button:first-child { border-left: 0; }
.seg button[aria-pressed="true"] { background: var(--ink); color: var(--bg); }
.seg button:focus-visible, .btn:focus-visible, .choice:focus-visible, input:focus-visible { outline: 3px solid var(--sticker); outline-offset: 2px; }

/* the tape case */
.case {
  position: relative; background: var(--panel); border: 3px solid var(--ink); border-radius: 14px;
  padding: 0; overflow: hidden; box-shadow: 6px 6px 0 var(--ink);
}
.spine {
  display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap;
  background: var(--accent); color: var(--accent-ink); padding: 10px 18px;
  font-family: var(--font-mono); font-size: 13px; letter-spacing: .08em; text-transform: uppercase;
}
.spine b { font-weight: 500; }
.case-body { padding: 26px 22px 22px; display: grid; gap: 22px; }
.sticker {
  position: absolute; top: 52px; right: 14px; transform: rotate(8deg);
  background: var(--sticker); color: var(--sticker-ink); border-radius: 50%;
  width: 76px; height: 76px; display: grid; place-items: center; text-align: center;
  font-family: var(--font-display); font-size: 14px; line-height: 1.1; padding: 6px; text-transform: uppercase; letter-spacing: .04em;
  border: 2px solid var(--sticker-ink);
}
.label { font-size: 11px; text-transform: uppercase; letter-spacing: .14em; color: var(--muted); font-weight: 700; margin: 0 0 8px; }
.desc {
  font-family: var(--font-mono);
  font-size: clamp(21px, 4.4vw, 28px); line-height: 1.3; font-weight: 700; margin: 0;
  max-width: 24ch; text-wrap: balance; padding-right: 70px;
}
.desc::before { content: "\201C"; color: var(--accent); }
.desc::after { content: "\201D"; color: var(--accent); }

.hints { display: grid; gap: 8px; }
.hint-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
.hint-list li {
  background: var(--soft); border-radius: 8px; padding: 9px 12px; display: flex; gap: 10px; align-items: baseline;
  animation: pop .25s ease-out;
}
.hint-list li i { font-style: normal; font-family: var(--font-mono); font-size: 12px; color: var(--accent); white-space: nowrap; }
.hint-list li span { min-width: 0; }
.letters { font-family: var(--font-mono); letter-spacing: .18em; word-break: break-word; }
@keyframes pop { from { transform: translateY(4px); opacity: .4; } to { transform: none; opacity: 1; } }

.row { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
.btn {
  font: 700 15px var(--font-body); padding: 10px 16px; border-radius: 8px; cursor: pointer;
  border: 2px solid var(--ink); background: var(--panel); color: var(--ink);
}
.btn.primary { background: var(--ink); color: var(--bg); }
.btn.hot { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }
.btn:disabled { opacity: .45; cursor: not-allowed; }
.btn.ghost { border-color: transparent; background: transparent; color: var(--muted); text-decoration: underline; padding-inline: 6px; }

.guess { display: flex; gap: 10px; flex-wrap: wrap; }
.guess input {
  flex: 1 1 220px; min-width: 0; font: 600 17px var(--font-body); padding: 11px 14px;
  border: 2px solid var(--ink); border-radius: 8px; background: var(--panel); color: var(--ink);
}
.choices { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px; }
.choice {
  font: 600 16px var(--font-body); text-align: left; padding: 12px 14px; border-radius: 8px;
  border: 2px solid var(--ink); background: var(--panel); color: var(--ink); cursor: pointer;
}
.choice:hover:not(:disabled) { background: var(--soft); }
.choice.right { background: var(--good); border-color: var(--good); color: var(--panel); }
.choice.wrong { background: var(--bad); border-color: var(--bad); color: var(--panel); }

.meta { font-family: var(--font-mono); font-size: 13px; color: var(--muted); font-variant-numeric: tabular-nums; }
.feedback { min-height: 1.5em; font-weight: 600; margin: 0; }
.feedback.good { color: var(--good); }
.feedback.bad { color: var(--bad); }

.reveal { border-top: 2px dashed var(--line); padding-top: 18px; display: grid; gap: 8px; }
.reveal h2 { font-family: var(--font-display); font-weight: 400; font-size: clamp(28px, 6vw, 40px); text-transform: uppercase; letter-spacing: .02em; margin: 0; line-height: 1.1; text-wrap: balance; }
.reveal p { margin: 0; color: var(--muted); max-width: 60ch; }

.end { text-align: left; display: grid; gap: 14px; }
.end h2 { font-family: var(--font-display); font-weight: 400; font-size: clamp(28px, 6vw, 40px); margin: 0; line-height: 1; }
.recap { list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; }
.recap li { display: flex; justify-content: space-between; gap: 12px; border-bottom: 1px solid var(--line); padding: 6px 0; }
.recap li span:last-child { font-family: var(--font-mono); font-variant-numeric: tabular-nums; white-space: nowrap; }

.rules { color: var(--muted); font-size: 14px; max-width: 65ch; margin: 0; }
.rules b { color: var(--ink); }

@media (max-width: 480px) {
  .sticker { width: 62px; height: 62px; font-size: 10px; top: 48px; }
  .desc { padding-right: 56px; }
  .case-body { padding: 22px 16px 18px; }
}
@media (prefers-reduced-motion: reduce) { .hint-list li { animation: none; } }
</style>

<div class="wrap">
  <header>
